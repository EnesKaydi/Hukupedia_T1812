# Bu dosyayı .env olarak kopyala ve şifreyi değiştir. .env git'e girmez (.gitignore).
POSTGRES_PASSWORD=degistir-beni

# Betiklerin ve API'nin kullandığı bağlantı (şifre yukarıdakiyle aynı olmalı)
HUKUPEDIA_DSN=host=localhost port=5432 dbname=hukupedia user=hukupedia password=degistir-beni

# (İsteğe bağlı) kendi karar veri setinin bulunduğu klasör; varsayılan ../data
# HUKUPEDIA_VERI=../data
